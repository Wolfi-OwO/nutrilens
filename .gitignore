# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build output
dist/
dist-ssr/
build/
*.egg-info/
*.tsbuildinfo

# Env / secrets
# Wildcard catches all .env variants (.production, .staging, .development, etc) at any
# depth. The enumerated form previously missed .env.production/.env.staging on this public repo.
**/.env*
!.env.example
!apps/api/.env.example
!apps/frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Editors / OS
.vscode/*
**/.claude/
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.swp

# Test / coverage
coverage/
.coverage
htmlcov/
.pytest_cache/
test-results/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
