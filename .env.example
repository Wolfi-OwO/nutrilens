# Copied to .env and read by docker-compose.yml for local development of
# the full stack (postgres + apps/api + apps/ai-server together). Each
# service also has its own .env.example for developing it in isolation —
# see apps/api/.env.example and apps/ai-server's Settings in src/ai_server/config.py.

# Secret used to sign session JWTs. The default below is fine for local
# development only — generate a real one with `openssl rand -base64 48`
# for anything that isn't your own machine.
JWT_SECRET=local-dev-only-jwt-secret-do-not-use-in-production

# OAuth login (issue #153) — optional. Leave unset for a login/register
# page with no provider buttons. The "nutrilens-staging" Google Cloud
# project and its OAuth client exist specifically for this: registered
# against http://localhost:8080's callback URLs, left in Testing mode
# (100 test users, added by hand in the console) so it can't be mistaken
# for the published production app. Ask for the staging credentials
# rather than pointing this at production's.
OAUTH_FRONTEND_BASE_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
