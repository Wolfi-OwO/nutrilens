{
  "name": "@nutrilens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Main application server: authentication, diet plans, meal logs, and the client used by the frontend. Delegates food-photo analysis to apps/ai-server.",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=.env.test --experimental-strip-types --test",
    "database:migrate": "node --env-file-if-exists=.env scripts/run-migrations.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "pino-http": "^10.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.11.10"
  }
}
