{
  "name": "@nutrilens/api",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Main application server: authentication, diet plans, meal logs, and the client used by the frontend. Delegates food-photo analysis to apps/ai-server.",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node -e \"const fs = require('fs'); fs.cpSync('src/data', 'dist/data', {recursive: true})\"",
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=.env.test --experimental-strip-types --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=85 --test-coverage-branches=65 --test-coverage-functions=80 --test",
    "database:migrate": "node --env-file-if-exists=.env scripts/run-migrations.mjs",
    "database:seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.13.0",
    "pino": "^9.14.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.20.4",
    "@types/swagger-ui-express": "^4.1.8"
  }
}
