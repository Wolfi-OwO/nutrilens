# HTTP port the API listens on. Defaults to 8080 if unset.
PORT=8080

# PostgreSQL connection string. Required — the server refuses to start
# without it. Point at any Postgres 14+ instance.
DATABASE_URL=postgresql://user:pass@localhost:5432/nutrilens

# Secret used to sign session JWTs. Required — the server refuses to start
# without it. Generate with `openssl rand -base64 48` and never reuse it
# across environments.
JWT_SECRET=

# How long a session token stays valid before a client must log in again.
# Accepts jsonwebtoken's `expiresIn` format: a number of seconds, or a
# vercel/ms string like "1h", "15m", "7d". Defaults to 1h if unset.
JWT_EXPIRES_IN=1h

# Base URL of the internal-only AI-detection service. Optional — meal
# logging works with none of this set; only the photo-prediction path needs
# it. See organizational/adr/0003-ai-server-client-contract.md.
AI_SERVER_URL=http://localhost:8000

# NFR-SEC-01: shared secret sent as X-Internal-Service-Token on every
# ai-server request, checked against that service's own
# AI_SERVER_INTERNAL_SERVICE_TOKEN. Optional — unset means ai-server accepts
# requests unauthenticated (fine for local dev; both are set to matching
# real values in CI/Azure). Generate with `openssl rand -hex 32`.
INTERNAL_SERVICE_TOKEN=
